# =============================================================================
# .env — Configuración y Credenciales
# =============================================================================
# IMPORTANTE: Este archivo NUNCA debe subirse al repositorio.
# Agrégalo a .gitignore si aún no está incluido.
#
# Los scripts en execution/ leen variables de aquí usando python-dotenv:
#   from dotenv import load_dotenv
#   load_dotenv()
#   valor = os.getenv("NOMBRE_VARIABLE")
# =============================================================================

# --- API Keys ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- Configuración del proyecto ---
# PROJECT_NAME=bioanalisis
# DATA_DIR=./data
# OUTPUT_DIR=./output

# --- Base de datos (si aplica) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=bioanalisis
# DB_USER=
# DB_PASSWORD=

# --- Otros servicios ---
# (añadir conforme se necesiten)
